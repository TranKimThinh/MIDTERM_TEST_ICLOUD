<h2>Thêm Sách Mới</h2>
<form action="/add" method="POST">
    <input type="text" name="productId" placeholder="Mã SP (VD: 26401)" required>
    <input type="text" name="title" placeholder="Tên sách" required>
    <input type="number" name="originalPrice" placeholder="Giá gốc" required>
    <button type="submit">Lưu xuống Cloud</button>
</form>

<h2>Danh sách Sách</h2>
<table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse; width: 100%; margin-top: 10px;">
    <thead>
        <tr style="background-color: #f2f2f2; text-align: left;">
            <th>Mã SP</th>
            <th>Tên sách</th>
            <th>Giá gốc</th>
            <th>Sau thuế</th>
        </tr>
    </thead>
    <tbody>
        {{#each books}}
        <tr>
            <td>{{this.productId}}</td>
            <td>{{this.title}}</td>
            <td>{{this.originalPrice}}</td>
            <td><b>{{this.priceAfterTax}}</b></td>
        </tr>
        {{/each}}
    </tbody>
</table>